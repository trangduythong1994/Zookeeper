{
  "name": "discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, extensible Discord bot.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/commands/ping.verify.js"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "^22.18.12",
    "eslint": "9.18.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "tsx": "^4.20.6"
  }
}

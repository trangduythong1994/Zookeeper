# Required: Discord bot token from the Developer Portal.
DISCORD_TOKEN=
# Optional local SQLite database path.
DATABASE_PATH=work/zookeeper.sqlite
# Optional: Google Cloud Text-to-Speech API key. Leave blank to use free Google TTS fallback.
GOOGLE_CLOUD_TTS_API_KEY=
# Optional: OpenAI API key for normal text chat when a member tags Zookeeper.
OPENAI_API_KEY=
# Hard local monthly ceiling for Zookeeper AI chat, in USD.
OPENAI_AI_MONTHLY_BUDGET_USD=3
